{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "node",
    "checkJs": false,
    "noEmit": true
  },
  "include": [
    "server.js",
    "config/**/*.js",
    "controllers/**/*.js",
    "middleware/**/*.js",
    "models/**/*.js",
    "routes/**/*.js"
  ],
  "exclude": ["node_modules"]
}
